{
  "name": "nuprix-backend",
  "private": true,
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:build": "npm --prefix apps/backend run build -- --no-lint",
    "backend:start": "npm --prefix apps/backend run start",
    "backend:api": "turbo run dev:api --filter=@dtc/backend",
    "backend:seed": "turbo seed --filter=@dtc/backend",
    "backend:dev": "turbo dev --filter=@dtc/backend",
    "storefront:dev": "turbo dev --filter=@dtc/storefront"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5",
      "tsconfig-paths": "^4.2.0"
    }
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.22.7",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "turbo": "^2.0.14",
    "ajv": "^8.13.0"
  },
  "workspaces": [
    "apps/**",
    "!apps/backend/.medusa/**"
  ],
  "overrides": {
    "eslint": {
      "ajv": "^6.12.4"
    },
    "@eslint/eslintrc": {
      "ajv": "^6.12.4"
    }
  },
  "allowScripts": {
    "@swc/core@1.16.22": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "msgpackr-extract@3.0.7": true
  }
}
