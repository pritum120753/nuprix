# Nuprix storefront (copy to .env.local)
# Keep this file committed with placeholders only; never commit real keys.

NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_replace_with_your_medusa_publishable_key
# The starter seed currently uses Denmark (dk). Change to bd after creating
# a Bangladesh region and adding Bangladesh to its countries in Medusa Admin.
NEXT_PUBLIC_DEFAULT_REGION=dk
NEXT_PUBLIC_BASE_URL=http://localhost:8000
NEXT_PUBLIC_STRIPE_KEY=
