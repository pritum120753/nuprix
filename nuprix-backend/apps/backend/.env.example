# Nuprix backend (copy to .env). Keep this file placeholders-only; never
# commit real keys or passwords.

# --- Core ---
DATABASE_URL=postgres://postgres:password@localhost:5432/nuprix
# Set to true for hosted PostgreSQL TLS connections. Use DATABASE_CA_CERT or
# DATABASE_CA_CERT_PATH when the provider supplies a custom CA.
DATABASE_SSL=false
DATABASE_CA_CERT=
DATABASE_CA_CERT_PATH=
# Optional SSL for hosted Postgres (e.g. Supabase). Provide inline PEM, a path
# relative to apps/backend, or place supabase-ca.crt in apps/backend/.
# DATABASE_SSL=true
# DATABASE_CA_CERT_PATH=./supabase-ca.crt
# DATABASE_CA_CERT=
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000,http://localhost:8000
# Use long random values (for example: openssl rand -hex 32). Required in production.
JWT_SECRET=replace-with-a-long-random-value
COOKIE_SECRET=replace-with-another-long-random-value

# --- Digital downloads: PRIVATE bucket for paid files ---
# Supabase: Storage > S3 connection. Keep the bucket PRIVATE.
DIGITAL_S3_ENDPOINT=https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3
DIGITAL_S3_REGION=ap-southeast-1
DIGITAL_S3_BUCKET=nuprix-private
DIGITAL_S3_ACCESS_KEY_ID=
DIGITAL_S3_SECRET_ACCESS_KEY=
# Public URL of this backend. Download links in emails are built from it.
DOWNLOAD_BASE_URL=http://localhost:9000
# Development only: serve files before payment is captured. Never true in production.
DIGITAL_ALLOW_UNCAPTURED=false
DIGITAL_DOWNLOAD_IP_SALT=
# 64 hexadecimal characters: losing this key makes stored license keys unreadable.
DIGITAL_LICENSE_ENCRYPTION_KEY=
ADMIN_DISABLED=false

# --- Email (Resend). Leave empty to disable email sending ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=Nuprix <orders@your-verified-domain.com>

# --- Payments (Stripe + SSLCommerz). Leave empty for manual/test only ---
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWD=
SSLCOMMERZ_SANDBOX=true
STOREFRONT_URL=http://localhost:8000
